# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# ── 渲染产物：不入库（体积大且可再生）/ Render outputs: large and reproducible
out/
!out/.gitkeep

# ── 素材：图片与音频为外部素材，不入库 ────────────────────────────────────
# 保留目录结构与索引文件（索引是人工判读的成果，必须入库）。
assets/images/*.jpg
assets/images/*.png
assets/audio/*.wav
assets/audio/*.mp3
assets/fonts/*.ttf
assets/fonts/*.otf
!assets/images/index.json
!assets/audio/*.srt

# ── 素材集：与上面同一套原则 / Asset sets: same policy ──────────────────────
# 大文件（图片 / 音频）不入库，索引与元数据入库。
#
# ⚠️ 上面的规则**不级联到子目录** —— `assets/audio/*.wav` 匹配不到
# `assets/sets/x/audio/y.wav`，所以素材集必须单独写一份，否则会漏进去 7 MB。
#
# The rules above do NOT cascade into subdirectories, so the asset-set layout
# needs its own entries or its media would be committed by accident.
assets/sets/*/images/*.png
assets/sets/*/images/*.jpg
assets/sets/*/images/*.jpeg
assets/sets/*/images/*.webp
assets/sets/*/audio/*.wav
assets/sets/*/audio/*.mp3

# ── 密钥：绝不入库 / Secrets: never committed
.env
.env.local

# ── npm / Node（Remotion 工程在 remotion/ 子目录）────────────────────────
node_modules/
npm-debug.log*
.npm-cache/
.npm-tmp/

# ── Remotion 的 public/ 是 assets/ 的同步副本（脚本复制，非链接）──────────
# 不入库：源在 assets/，remotion/public 由 scripts/link-assets.ps1 生成。
# Remotion 的 staticFile() 只认「与 package.json 同级的 public/」，
# 无法直接指向 assets/，所以必须复制一份。
remotion/public/
remotion/out/

# ── 运行时日志 / Runtime logs ─────────────────────────────────────────────
remotion/*.log
*.render.log

# ── Remotion 预编码临时目录（必须留在工作区内，见 issues/005）────────────
.render-tmp/

# ── 编辑器 / OS ──────────────────────────────────────────────────────────
.vscode/
.idea/
Thumbs.db
desktop.ini
